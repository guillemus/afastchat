#!/usr/bin/env bash
#MISE description="Build and deploy production to hetzner-box"
set -euo pipefail

binary=$(mktemp)
trap 'rm -f "$binary"' EXIT

mise run build-assets
mise run templ-generate

CGO_ENABLED=0 GOOS=linux GOARCH=arm64 \
    go build -trimpath -ldflags='-s -w' -o "$binary" ./cmd/server

# Keep the uploaded binary between deploys so rsync can transfer only changes.
rsync --checksum --compress --progress "$binary" hetzner-box:/tmp/afastchat-server

ssh hetzner-box '
    set -eu

    sudo install -o afastchat -g afastchat -m 0755 \
        /tmp/afastchat-server /srv/afastchat/afastchat.new
    sudo mv /srv/afastchat/afastchat.new /srv/afastchat/afastchat

    sudo systemctl restart afastchat
    systemctl is-active afastchat
'
