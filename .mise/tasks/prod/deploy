#!/usr/bin/env bash
#MISE description="Build and deploy production to $DEPLOY_HOST"
set -euo pipefail

host=${DEPLOY_HOST:?set DEPLOY_HOST to the SSH host alias of the production server}

binary=$(mktemp)
trap 'rm -f "$binary"' EXIT

mise run build-assets
mise run templ-generate

CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags='-s -w' -o "$binary" ./cmd/server

# Keep the uploaded binary between deploys so rsync can transfer only changes.
rsync --checksum --compress --progress "$binary" "$host:apps/afastchat/afastchat.upload"

ssh "$host" '
    set -eu

    cd ~/apps/afastchat
    install -m 0755 afastchat.upload afastchat.new
    mv -f afastchat.new afastchat

    sudo systemctl restart afastchat
    systemctl is-active afastchat
'
