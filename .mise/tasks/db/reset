#!/usr/bin/env bash
#MISE description="Delete the local sqlite database and let the server recreate it from migrations"
set -euo pipefail

if [[ $# != 1 || $1 != --yes ]]; then
    echo "usage: mise run db:reset --yes"
    echo "Deletes all local application data. Stop the dev server first."
    exit 2
fi

rm -f tmp/app.db tmp/app.db-shm tmp/app.db-wal
printf 'Local database deleted. Migrations run on next server start.\n'
