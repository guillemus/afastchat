#!/usr/bin/env bash
#MISE description="Reject app styles that bypass the design tokens in views/styles.css"
set -euo pipefail

cd "$(git rev-parse --show-toplevel)/views"

palette='slate|gray|zinc|neutral|stone|red|orange|amber|yellow|lime|green|emerald|teal|cyan|sky|blue|indigo|violet|purple|fuchsia|pink|rose'
pattern="text-\[[0-9.]+(px|rem)\]|text-(xs|sm|base|lg|[0-9]?xl)([^a-z0-9-]|$)|-\[#[0-9a-fA-F]{3,8}\]|-($palette)-[0-9]{2,3}([^0-9]|$)"

if find . -name '*.templ' |
  grep -vE '^\./landing\.templ$' |
  xargs grep -nE "$pattern"; then
  echo "Use the type and color tokens in views/styles.css." >&2
  exit 1
fi
