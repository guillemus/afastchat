package ui

import "afastchat.com/config"

const siteDescription = "A very fast AI chat built for the web. Streams in real time, searches the live web, and runs on your OpenRouter account."

templ Document(title string) {
	<!DOCTYPE html>
	<html lang="en" class="bg-canvas text-ink scheme-dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<meta name="description" content={ siteDescription }/>
			<meta property="og:type" content="website"/>
			<meta property="og:site_name" content="afastchat"/>
			<meta property="og:title" content={ title }/>
			<meta property="og:description" content={ siteDescription }/>
			<meta property="og:url" content={ config.AppURL() }/>
			<meta property="og:image" content={ config.AppURL() + "/public/og.png" }/>
			<meta property="og:image:width" content="1200"/>
			<meta property="og:image:height" content="630"/>
			<meta property="og:image:alt" content="afastchat — A very fast AI chat. Built for the web."/>
			<meta name="twitter:card" content="summary_large_image"/>
			<meta name="twitter:title" content={ title }/>
			<meta name="twitter:description" content={ siteDescription }/>
			<meta name="twitter:image" content={ config.AppURL() + "/public/og.png" }/>
			<link rel="icon" href="/public/favicon.ico" sizes="32x32"/>
			<link rel="icon" href="/public/favicon.svg" type="image/svg+xml"/>
			<link rel="apple-touch-icon" href="/public/apple-touch-icon.png"/>
			<link rel="manifest" href="/public/site.webmanifest"/>
			<link
				rel="preload"
				href="/public/fonts/funnel-display-latin-var.woff2"
				as="font"
				type="font/woff2"
				crossorigin
			/>
			<link
				rel="preload"
				href="/public/fonts/jetbrains-mono-latin-var.woff2"
				as="font"
				type="font/woff2"
				crossorigin
			/>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"/>
			<link rel="stylesheet" href={ "/public/styles.css?v=" + config.AssetVersion }/>
			<link rel="modulepreload" href="/public/datastar-rocket-v1.0.4.js"/>
			<script type="module" src={ "/public/index.js?v=" + config.AssetVersion }></script>
			<script type="speculationrules">
				{
					"prefetch": [
						{
							"source": "document",
							"where": { "selector_matches": "[data-prefetch-immediate]" },
							"eagerness": "immediate"
						},
						{
							"source": "document",
							"where": { "selector_matches": "[data-prefetch-eager]" },
							"eagerness": "eager"
						},
						{
							"source": "document",
							"where": { "selector_matches": "[data-prefetch-moderate]" },
							"eagerness": "moderate"
						},
						{
							"source": "document",
							"where": { "selector_matches": "[data-prefetch-conservative]" },
							"eagerness": "conservative"
						}
					]
				}
			</script>
		</head>
		<body
			data-signals:_toast={ defaultToastSignals }
			data-signals:_live_updates_disconnected="false"
			data-on:datastar-fetch="
				if (evt.detail.type === 'error' && evt.detail.argsRaw.status === '502') {
					if (!$_live_updates_disconnected) {
						$_live_updates_disconnected = true;
						$_toast = {
							id: Date.now(),
							visible: true,
							kind: 'warning',
							message: 'Live updates disconnected. Reconnecting…',
							link: { label: '', href: '' }
						};
					}
				} else if (
					$_live_updates_disconnected &&
					evt.detail.type.startsWith('datastar-patch-')
				) {
					$_live_updates_disconnected = false;
					$_toast = {
						id: Date.now(),
						visible: true,
						kind: 'info',
						message: 'Live updates reconnected.',
						link: { label: '', href: '' }
					};
				}
			"
		>
			@ToastView()
			@ImageModal()
			{ children... }
			if config.Dev {
				@DebugSignals()
			}
		</body>
	</html>
}

templ DebugSignals() {
	<div
		style="display: none"
		class="
			fixed right-5 top-2 z-2147483647 flex max-h-[calc(100vh-(--spacing(4)))] w-125 flex-col
			overflow-hidden bg-backdrop p-2
		"
		data-signals={ "{_sig_debug_signals_visible: (localStorage.getItem('debug_signals_visible') ?? 'false') === 'true'}" }
		data-on:keydown__window="
			if (event.ctrlKey && event.key === 'f') {
				event.preventDefault();
				$_sig_debug_signals_visible = !$_sig_debug_signals_visible;
			}
		"
		data-effect="localStorage.setItem('debug_signals_visible', $_sig_debug_signals_visible)"
		data-show="$_sig_debug_signals_visible"
	>
		<div class="flex flex-none items-center justify-between gap-2">
			<small>signals:</small>
			@Button(ButtonProps{
				Variant: Text,
				Size:    Small,
				Attrs: templ.Attributes{
					"aria-live": "polite",
					"data-on:click": `
					const signals = el.parentElement.nextElementSibling.textContent;
					navigator.clipboard.writeText('client datastar signals state: ' + signals).then(() => {
						el.textContent = 'Copied';
					}, () => {
						el.textContent = 'Copy failed';
					});
				`,
				},
			}) {
				Copy
			}
		</div>
		<pre class="min-h-0 overflow-auto whitespace-pre bg-backdrop" data-json-signals></pre>
	</div>
}
