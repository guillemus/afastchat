package ui

templ PlusIcon() {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width="14"
		height="14"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2.5"
		stroke-linecap="round"
		aria-hidden="true"
	>
		<path d="M12 5v14"></path>
		<path d="M5 12h14"></path>
	</svg>
}

