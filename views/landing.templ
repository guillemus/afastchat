package views

import "afastchat.com/views/ui"

templ landing(model ModelOption) {
	<aside id="sidebar" class="min-h-0 overflow-hidden border-r border-line-subtle bg-sidebar">
		<div class="flex h-full w-sidebar flex-col px-2.5 pt-2.25 pb-3">
			@sidebarBrand()
			<a href="/login" class={ sidebarNewChatClass }>
				<span class="text-ink-secondary">
					@ui.PlusSmallIcon()
				</span>
				New chat
			</a>
			<a href="/login" class={ sidebarSearchClass, "no-underline hover:border-line" }>
				@ui.SearchSmallIcon()
				<span class="flex-1">Search chats</span>
				<kbd class="kbd">/</kbd>
			</a>
			<div class="mt-auto flex flex-col gap-2.5 border-t border-line-subtle px-1 pt-2.5">
				@ui.ButtonLink("/login", ui.ButtonProps{Variant: ui.Secondary, Size: ui.Small, Class: "w-full"}) {
					Log in
				}
				<div class="flex justify-center gap-3 text-meta text-muted">
					<a href="/privacy" class="no-underline transition-colors hover:text-ink">Privacy</a>
					<a href="/terms" class="no-underline transition-colors hover:text-ink">Terms</a>
				</div>
			</div>
		</div>
	</aside>
	<main class="flex h-full min-h-0 min-w-0 flex-col overflow-hidden bg-canvas">
		<div class="flex min-h-0 flex-1 flex-col items-center justify-center px-6 pb-20">
			<h2 class="mb-5.5 text-headline font-medium text-ink">What's on your mind?</h2>
			<div class="w-full max-w-thread">
				<div class={ chatDockClass }>
					<a href="/login" class="block min-h-8 px-2.5 py-1.5 text-body leading-5 text-muted no-underline">
						Ask anything
					</a>
					<div class="flex items-center gap-2">
						@ui.ButtonLink("/login", ui.ButtonProps{
							Variant: ui.Ghost,
							Size:    ui.Icon,
							Label:   "Attach image",
							Class:   "rounded-full",
						}) {
							@ui.ImageSmallIcon()
						}
						<a href="/login" aria-label="Choose model" class={ modelPickerTriggerClass }>
							<span class="min-w-0 truncate">{ model.Name }</span>
							@modelCost(model.CostTier)
							<span class="flex-none text-muted">
								@ui.ChevronDownSmallIcon()
							</span>
						</a>
						<a href="/login" aria-label="Send message" class={ chatSendClass, "bg-surface-strong text-muted" }>
							@ui.ArrowUpSmallIcon()
						</a>
					</div>
				</div>
			</div>
		</div>
	</main>
}
