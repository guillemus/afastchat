package views

import (
	"afastchat.com/views/ui"
	"fmt"
	"time"
)

type SidebarProps struct {
	Threads        []Thread
	ActiveThreadID string
	Viewer         Viewer
}

const sidebarDeleteThreadDialogID = "sidebar-delete-thread-dialog"

const threadActionButtonClass = `
	grid size-6 cursor-pointer place-items-center rounded-md text-muted transition-colors
	hover:bg-fill-strong hover:text-ink focus-visible:outline-none focus-visible:bg-fill-strong
`

const sidebarIconButtonClass = `
	grid size-6.5 flex-none cursor-pointer place-items-center rounded-md text-muted transition-colors
	hover:bg-fill-strong hover:text-ink
`

templ Sidebar(props SidebarProps) {
	<aside
		id="sidebar"
		class="min-h-0 overflow-hidden border-r border-line-subtle bg-sidebar"
		data-signals:thread-id={ fmt.Sprintf("'%s'", props.ActiveThreadID) }
		data-signals:rename-title__ifmissing="''"
		if props.ActiveThreadID != "" {
			data-signals:_stream-thread={ fmt.Sprintf("'%s'", props.ActiveThreadID) }
			data-effect="@get('/threads/' + $_streamThread + '/events', { requestCancellation: 'cleanup' })"
			data-on:mousedown="
				const link = evt.target.closest('#thread-items a');
				if (!link || link.hasAttribute('data-editing') || evt.target.closest('[data-thread-actions]')) return;
				if (evt.button !== 0 || evt.metaKey || evt.ctrlKey || evt.shiftKey || evt.altKey) return;
				$_streamThread = link.id.slice('thread-'.length);
			"
			data-on:click="
				const link = evt.target.closest('#thread-items a');
				if (!link || evt.target.closest('[data-thread-actions]') || evt.metaKey || evt.ctrlKey || evt.shiftKey || evt.altKey) return;
				evt.preventDefault();
				if (!link.hasAttribute('data-editing')) $_streamThread = link.id.slice('thread-'.length);
			"
			data-on:popstate__window="
				const [, page, id] = location.pathname.split('/');
				if (page === 'threads' && id) $_streamThread = id;
			"
		}
		data-on:keydown__window="
			if (evt.target.closest('input, textarea, [contenteditable]')) return;
			if (evt.key === '/') {
				evt.preventDefault();
				document.getElementById('thread-search')?.focus();
			} else if ((evt.metaKey || evt.ctrlKey) && evt.shiftKey && evt.key.toLowerCase() === 'o') {
				evt.preventDefault();
				window.location.href = '/';
			}
		"
	>
		<div
			class="flex h-full w-sidebar flex-col px-2.5 pt-2.25 pb-3"
			data-signals:_pinned-collapsed="localStorage.getItem('pinned_collapsed') === 'true'"
			data-effect="localStorage.setItem('pinned_collapsed', $_pinnedCollapsed)"
		>
			<div class="flex h-7.5 items-center justify-center">
				<a href="/" class="text-subheading font-semibold tracking-tighter text-ink no-underline">afastchat</a>
			</div>
			<a
				href="https://designobo.com"
				target="_blank"
				rel="noopener"
				class="flex items-center gap-1 self-center text-meta text-muted no-underline transition-colors hover:text-ink"
			>
				made with
				@ui.DesignoboMark()
				designobo
			</a>
			<a
				href="/"
				data-prefetch-immediate
				class="
				bg-raised-button mt-3 flex h-8 items-center gap-2 rounded-lg border border-line pr-1.5 pl-2.25
				font-medium text-ink no-underline shadow-button transition-colors hover:border-line-strong
			"
			>
				<span class="text-ink-secondary">
					@ui.PlusSmallIcon()
				</span>
				New chat
			</a>
			<label
				class="
				mt-2 flex h-7.5 cursor-text items-center gap-2 rounded-lg border border-line-subtle pr-1.5
				pl-2.25 text-muted transition-colors focus-within:border-line
			"
			>
				@ui.SearchSmallIcon()
				<input
					id="thread-search"
					class="min-w-0 flex-1 bg-transparent text-ink outline-none placeholder:text-muted"
					type="text"
					name="thread-search"
					placeholder="Search chats"
					autocomplete="off"
					data-bind:thread-search
					data-on:input__debounce.150ms="@get('/threads/search')"
					data-on:keydown="evt.key === 'Escape' && el.blur()"
				/>
				<kbd class="kbd">/</kbd>
			</label>
			@ThreadList(props.Threads, props.ActiveThreadID)
			<div class="mt-auto flex items-center gap-2.5 border-t border-line-subtle px-1 pt-2.5">
				<a
					href="/settings"
					aria-label="Settings"
					class="
					grid size-6.5 flex-none place-items-center rounded-full bg-surface-strong text-meta
					font-semibold tracking-wide text-ink no-underline shadow-active transition-colors
					hover:bg-fill-strong focus-visible:outline-2 focus-visible:outline-offset-2
					focus-visible:outline-accent
				"
				>
					{ initials(props.Viewer) }
				</a>
				<div class="min-w-0 leading-tight">
					<p class="truncate font-medium text-ink">{ props.Viewer.Name }</p>
					<div class="text-meta text-muted">
						@ui.Sensitive(props.Viewer.Email)
					</div>
				</div>
				<form method="post" action="/logout" class="ml-auto">
					<button type="submit" aria-label="Log out" title="Log out" class={ sidebarIconButtonClass }>
						@ui.LogOutIcon()
					</button>
				</form>
			</div>
		</div>
		@threadListScrollRestore()
		@sidebarDeleteThreadDialog()
	</aside>
}

templ sidebarDeleteThreadDialog() {
	@ui.Dialog(sidebarDeleteThreadDialogID, templ.Attributes{"data-signals:_delete-thread-id": "''"}) {
		<h2 class="text-ui-emphasis font-semibold">Delete this chat?</h2>
		<p class="mt-2 leading-6 text-muted">
			The chat and all its messages are deleted. This can't be undone. Hold <kbd class="kbd">Shift</kbd> to skip this next time.
		</p>
		<div class="mt-6 flex justify-end gap-2">
			@ui.Button(ui.ButtonProps{
				Variant: ui.Ghost,
				Attrs:   templ.Attributes{"commandfor": sidebarDeleteThreadDialogID, "command": "close"},
			}) {
				Cancel
			}
			@ui.Button(ui.ButtonProps{
				Variant: ui.Danger,
				Attrs: templ.Attributes{
					"data-indicator:_sidebar_delete_pending": true,
					"data-attr:disabled":                     "$_sidebar_delete_pending",
					"data-on:click":                          "@post('/threads/' + $_deleteThreadId + '/delete')",
				},
			}) {
				Delete
			}
		</div>
	}
}

templ ThreadList(threads []Thread, activeThreadID string) {
	<div
		class="
			thread-list -mx-2.5 mb-2 min-h-0 flex-1 overflow-y-auto overscroll-contain px-2.5
			[scrollbar-color:var(--color-line-strong)_transparent] [scrollbar-width:thin]
		"
		data-on:scroll__debounce.10ms="sessionStorage.setItem('thread_list_scroll', String(el.scrollTop))"
	>
		@ThreadItems(threads, activeThreadID)
	</div>
}

templ threadListScrollRestore() {
	<script>
		{
			const el = document.querySelector('.thread-list')
			el.scrollTop = Number.parseFloat(sessionStorage.getItem('thread_list_scroll')) || 0
		}
	</script>
}

templ ThreadItems(threads []Thread, activeThreadID string) {
	{{ pinned, unpinned := splitPinned(threads) }}
	<div id="thread-items">
		if len(pinned) > 0 {
			@pinnedThreads(pinned, activeThreadID)
		}
		for _, group := range groupThreads(unpinned, viewerNow(ctx)) {
			<div class="mt-4 flex h-6 items-center px-2 text-meta font-medium tracking-wide text-muted">
				{ group.Label }
			</div>
			<div class="flex flex-col gap-px">
				for _, thread := range group.Threads {
					@ThreadListItem(thread, thread.ID == activeThreadID)
				}
			</div>
		}
	</div>
}

templ pinnedThreads(threads []Thread, activeThreadID string) {
	<section class="group/pinned" data-attr:data-collapsed="$_pinnedCollapsed">
		<script>
			{
				const section = document.currentScript.parentElement
				const collapsed = localStorage.getItem('pinned_collapsed') === 'true'
				section.toggleAttribute('data-collapsed', collapsed)
				section.querySelector('[data-pinned-items]').toggleAttribute('inert', collapsed)
			}
		</script>
		<button
			type="button"
			class="
				group/toggle mt-4 flex h-6 w-full cursor-pointer items-center gap-1.5 rounded-md px-2 text-meta
				font-medium tracking-wide text-muted transition-colors hover:text-ink
			"
			data-attr:aria-expanded="String(!$_pinnedCollapsed)"
			data-on:click="
				const section = el.closest('section');
				section.setAttribute('data-animating', '');
				clearTimeout(section.pinnedAnimation);
				section.pinnedAnimation = setTimeout(() => section.removeAttribute('data-animating'), 250);
				$_pinnedCollapsed = !$_pinnedCollapsed;
			"
		>
			<span class="[&_svg]:size-3">
				@ui.PinIcon()
			</span>
			Pinned
			<span
				class="
					ml-auto opacity-0 transition-opacity duration-200 group-hover/toggle:opacity-100
					group-focus-visible/toggle:opacity-100 group-data-collapsed/pinned:rotate-180
					group-data-animating/pinned:transition
				"
			>
				@ui.ChevronDownSmallIcon()
			</span>
		</button>
		<div
			class="
				grid grid-rows-[1fr] duration-200 ease-[cubic-bezier(0.2,0,0,1)] group-data-collapsed/pinned:grid-rows-[0fr]
				group-data-animating/pinned:transition-[grid-template-rows] motion-reduce:transition-none!
			"
		>
			<div
				data-pinned-items
				class="-mx-2.5 flex min-h-0 flex-col justify-end overflow-hidden px-2.5"
				data-attr:inert="$_pinnedCollapsed"
			>
				<div
					class="
						flex flex-col gap-px duration-200 group-data-collapsed/pinned:opacity-0
						group-data-animating/pinned:transition-opacity motion-reduce:transition-none!
					"
				>
					for _, thread := range threads {
						@ThreadListItem(thread, thread.ID == activeThreadID)
					}
				</div>
			</div>
		</div>
	</section>
}

templ ThreadListItem(thread Thread, isActive bool) {
	<a
		id={ "thread-" + thread.ID }
		class={
			"group relative grid h-7.5 grid-cols-[--spacing(3.5)_minmax(0,1fr)_auto] items-center gap-2 rounded-md px-2",
			"whitespace-nowrap no-underline transition-colors duration-100",
			templ.KV("bg-surface-raised text-ink shadow-active [--row-bg:var(--color-surface-raised)]", isActive),
			templ.KV("text-ink-secondary hover:bg-fill hover:text-ink [--row-bg:var(--color-sidebar-hover)]", !isActive),
		}
		href={ templ.SafeURL("/threads/" + thread.ID) }
		data-prefetch-moderate
		data-title={ thread.Title }
		data-preserve-attr="data-editing"
		if isActive {
			aria-current="page"
		}
		data-on:click="el.hasAttribute('data-editing') && evt.preventDefault()"
		data-on:dblclick="
			if (evt.target.closest('[data-thread-actions]')) return;
			const input = el.querySelector('input');
			input.value = el.dataset.title;
			el.setAttribute('data-editing', '');
			input.focus();
			input.select();
		"
	>
		<span
			class={ "absolute top-1.75 bottom-1.75 -left-2.5 w-0.5 rounded-sm bg-accent", templ.KV("hidden", !isActive) }
			aria-hidden="true"
		></span>
		<span class="grid place-items-center">
			if thread.IsStreaming && isActive {
				<span class="size-1.5 animate-pulse-dot rounded-full bg-accent"></span>
			} else if thread.IsStreaming {
				<span class="text-accent">
					@ui.SpinnerSmallIcon()
				</span>
			}
		</span>
		<span class="grid min-w-0 group-data-pending:opacity-50">
			<span data-thread-title class="truncate group-data-editing:hidden">{ thread.Title }</span>
			<input
				type="text"
				aria-label="Chat name"
				class="hidden min-w-0 bg-transparent p-0 text-ink outline-none group-data-editing:block"
				data-on:keydown="
					if (evt.key === 'Escape') el.closest('a').removeAttribute('data-editing');
					if (evt.key === 'Enter') el.blur();
				"
				data-on:blur={ renameThreadExpr(thread.ID) }
			/>
		</span>
		<time-ago
			datetime={ thread.CreatedAt.UTC().Format(time.RFC3339) }
			class={
				"text-meta tabular-nums transition-colors duration-100",
				templ.KV("text-accent", isActive),
				templ.KV("text-muted group-hover:text-ink", !isActive),
			}
		>{ timeAgo(thread.CreatedAt, time.Now()) }</time-ago>
		<span
			data-thread-actions
			class="absolute inset-y-0 right-0 flex overflow-hidden rounded-r-md group-data-editing:hidden"
		>
			<span
				class="
					flex translate-x-full items-center gap-0.5 bg-[linear-gradient(to_right,transparent,var(--row-bg)_--spacing(5))] pr-1
					pl-6 opacity-0 transition duration-150 ease-out group-focus-within:translate-x-0
					group-focus-within:opacity-100 group-hover:translate-x-0 group-hover:opacity-100
				"
			>
				if thread.IsPinned {
					<button
						type="button"
						aria-label="Unpin chat"
						title="Unpin"
						class={ threadActionButtonClass }
						data-on:click__prevent={ fmt.Sprintf("@post('/threads/%s/unpin')", thread.ID) }
					>
						@ui.PinOffIcon()
					</button>
				} else {
					<button
						type="button"
						aria-label="Pin chat"
						title="Pin"
						class={ threadActionButtonClass }
						data-on:click__prevent={ fmt.Sprintf("@post('/threads/%s/pin')", thread.ID) }
					>
						@ui.PinIcon()
					</button>
				}
				<button
					type="button"
					aria-label="Delete chat"
					title="Delete"
					class={ threadActionButtonClass, "hover:text-danger focus-visible:text-danger" }
					data-on:click__prevent={ deleteThreadExpr(thread.ID) }
				>
					@ui.TrashIcon()
				</button>
			</span>
		</span>
	</a>
}

func deleteThreadExpr(threadID string) string {
	return fmt.Sprintf(`
		if (evt.shiftKey) {
			@post('/threads/%[1]s/delete');
		} else {
			$_deleteThreadId = '%[1]s';
			document.getElementById('%[2]s').showModal();
		}
	`, threadID, sidebarDeleteThreadDialogID)
}

func renameThreadExpr(threadID string) string {
	return fmt.Sprintf(`
		const link = el.closest('a');
		const title = el.value.trim();
		if (link.hasAttribute('data-editing') && title && title !== link.dataset.title) {
			link.querySelector('[data-thread-title]').textContent = title;
			link.setAttribute('data-pending', '');
			$renameTitle = title;
			@post('/threads/%s/rename');
		}
		link.removeAttribute('data-editing');
	`, threadID)
}
