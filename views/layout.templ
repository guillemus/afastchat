package views

import "afastchat.com/views/ui"

templ appLayout() {
	@ui.Document("afastchat") {
		<div
			class="app-shell h-dvh w-full overflow-hidden"
			data-signals:_sidebar-collapsed="localStorage.getItem('sidebar_collapsed') === 'true'"
			data-effect="localStorage.setItem('sidebar_collapsed', $_sidebarCollapsed)"
			data-attr:data-collapsed="$_sidebarCollapsed"
		>
			<script>
				document.currentScript.parentElement.toggleAttribute(
					'data-collapsed',
					localStorage.getItem('sidebar_collapsed') === 'true',
				)
			</script>
			{ children... }
			<button
				type="button"
				aria-controls="sidebar"
				class="
					fixed top-2.75 left-4 z-20 grid size-6.5 cursor-pointer place-items-center rounded-md
					text-muted transition-colors hover:bg-fill-strong hover:text-ink
				"
				data-attr:aria-expanded="String(!$_sidebarCollapsed)"
				data-attr:aria-label="$_sidebarCollapsed ? 'Show sidebar' : 'Hide sidebar'"
				data-attr:title="$_sidebarCollapsed ? 'Show sidebar' : 'Hide sidebar'"
				data-on:click="
					const shell = el.closest('.app-shell');
					shell.setAttribute('data-animating', '');
					clearTimeout(shell.sidebarAnimation);
					shell.sidebarAnimation = setTimeout(() => shell.removeAttribute('data-animating'), 250);
					$_sidebarCollapsed = !$_sidebarCollapsed;
				"
			>
				@ui.PanelLeftIcon()
			</button>
		</div>
	}
}

templ guestLayout() {
	@ui.Document("afastchat") {
		<div class="min-h-dvh">
			{ children... }
		</div>
	}
}

templ IndexPage(data IndexData) {
	@appLayout() {
		@Sidebar(SidebarProps{Threads: data.Threads, Viewer: data.Viewer})
		@MessageThread(MessageThreadProps{Models: data.Models})
	}
}

templ ThreadPage(data ThreadData, doScrollSidebar bool) {
	@appLayout() {
		@Sidebar(SidebarProps{
			Threads:        data.Threads,
			ActiveThreadID: data.Thread.ID,
			Viewer:         data.Viewer,
		})
		@MessageThread(MessageThreadProps{
			Messages:        data.Messages,
			Thread:          data.Thread,
			DoScrollSidebar: doScrollSidebar,
			IsStreaming:     data.Streaming,
			Models:          data.Models,
		})
	}
}

templ SettingsPage(data SettingsData) {
	@appLayout() {
		@Sidebar(SidebarProps{Threads: data.Threads, Viewer: data.Viewer})
		@settings(data)
	}
}

templ LandingPage() {
	@guestLayout() {
		@landing()
	}
}

templ LoginPage(failed bool) {
	@guestLayout() {
		@login(failed)
	}
}

templ SetupPage(failed bool) {
	@guestLayout() {
		@setup(failed)
	}
}
