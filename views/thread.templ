package views

import (
	"afastchat.com/views/ui"
	"fmt"
	"strconv"
	"time"
)

const (
	threadMenuID         = "thread-menu"
	renameThreadDialogID = "rename-thread-dialog"
	deleteThreadDialogID = "delete-thread-dialog"
)

templ MessageThread(props MessageThreadProps) {
	<main class="flex h-full min-h-0 min-w-0 flex-col overflow-hidden bg-canvas">
		@ThreadHeader(props.Thread)
		if len(props.Messages) == 0 {
			<div class="flex min-h-0 flex-1 flex-col items-center justify-center px-6 pb-20">
				<h2 class="mb-5.5 text-headline font-medium text-ink">What's on your mind?</h2>
				<div class="w-full max-w-thread">
					@chatInput(props.Thread.ID, props.IsStreaming)
				</div>
			</div>
		} else {
			<div
				class="relative flex min-h-0 flex-1 flex-col overflow-hidden"
				data-signals:_show-jump-to-bottom="false"
				data-on:resize__window__debounce.50ms="
					if (!$_messages) return;
					const overflow = $_messages.scrollHeight - $_messages.clientHeight;
					const distanceFromBottom = overflow - $_messages.scrollTop;
					$_showJumpToBottom = overflow > 200 && distanceFromBottom > 48;
				"
			>
				@MessageList(props)
				<button
					type="button"
					aria-label="Jump to latest message"
					style="display: none"
					class="
						absolute bottom-4 left-1/2 z-10 grid size-9 -translate-x-1/2 cursor-pointer place-items-center
						rounded-full border border-line bg-surface-raised text-ink shadow-popover transition
						hover:-translate-y-px hover:border-line-strong focus-visible:outline-2 focus-visible:outline-accent
					"
					data-show="$_showJumpToBottom"
					data-on:click="
						$_messages.scrollTo({ top: $_messages.scrollHeight, behavior: 'smooth' });
						$_showJumpToBottom = false;
					"
				>
					@ui.ArrowDownIcon()
				</button>
			</div>
			<div class="flex-none px-6 pb-5">
				<div class="mx-auto max-w-thread">
					@chatInput(props.Thread.ID, props.IsStreaming)
				</div>
			</div>
		}
		if props.Thread.ID != "" {
			@threadMenu(props.Thread)
		}
		if props.DoScrollSidebar && len(props.Messages) > 0 {
			@messageScrollRestore()
		}
	</main>
}

templ ThreadHeader(thread Thread) {
	<header
		id="thread-header"
		class="thread-header flex h-12 flex-none items-center gap-2.5 border-b border-line-subtle pr-5"
	>
		if thread.ID != "" {
			<h1 class="min-w-0 truncate text-compact font-medium tracking-tight text-ink">{ thread.Title }</h1>
			<button
				type="button"
				aria-label="Chat options"
				popovertarget={ threadMenuID }
				class="
					ml-auto grid size-6.5 flex-none cursor-pointer place-items-center rounded-md text-muted
					transition-colors hover:bg-fill-strong hover:text-ink
				"
			>
				@ui.MoreIcon()
			</button>
		}
	</header>
}

const threadMenuItemClass = `
	flex h-8 w-full cursor-pointer items-center gap-2.5 rounded-md px-2.5 text-left text-ink-body
	transition-colors hover:bg-fill-strong hover:text-ink [&_svg]:text-muted
`

templ threadMenu(thread Thread) {
	<div
		id={ threadMenuID }
		popover
		class="
			fixed inset-auto top-11 right-5 m-0 w-44 rounded-lg border border-line bg-surface-raised p-1
			text-compact text-ink shadow-popover
		"
	>
		<button
			type="button"
			class={ threadMenuItemClass }
			commandfor={ renameThreadDialogID }
			command="show-modal"
			data-title={ thread.Title }
			data-on:click={ fmt.Sprintf("$renameTitle = el.dataset.title; document.getElementById('%s').hidePopover()", threadMenuID) }
		>
			@ui.PencilIcon()
			Rename
		</button>
		<button
			type="button"
			class={ threadMenuItemClass }
			data-on:click={ fmt.Sprintf("document.getElementById('%s').hidePopover(); @post('/threads/%s/archive')", threadMenuID, thread.ID) }
		>
			@ui.ArchiveSmallIcon()
			Archive
		</button>
		<button
			type="button"
			class={ threadMenuItemClass, "text-danger! [&_svg]:text-danger!" }
			commandfor={ deleteThreadDialogID }
			command="show-modal"
			data-on:click={ fmt.Sprintf("document.getElementById('%s').hidePopover()", threadMenuID) }
		>
			@ui.TrashIcon()
			Delete
		</button>
	</div>
	@ui.Dialog(renameThreadDialogID, templ.Attributes{"data-signals:rename-title": "''"}) {
		<h2 class="text-ui-emphasis font-semibold">Rename chat</h2>
		@ui.Input(ui.InputProps{
			Class: "mt-4",
			Attrs: templ.Attributes{
				"type":               "text",
				"aria-label":         "Chat name",
				"data-bind":          "renameTitle",
				"data-on:keydown":    fmt.Sprintf("evt.key === 'Enter' && @post('/threads/%s/rename')", thread.ID),
				"data-indicator":     "_renamePending",
				"data-attr:disabled": "$_renamePending",
			},
		})
		<div class="mt-6 flex justify-end gap-2">
			@ui.Button(ui.ButtonProps{
				Variant: ui.Ghost,
				Attrs:   templ.Attributes{"commandfor": renameThreadDialogID, "command": "close"},
			}) {
				Cancel
			}
			@ui.Button(ui.ButtonProps{
				Attrs: templ.Attributes{
					"data-attr:disabled": "$_renamePending",
					"data-on:click":      fmt.Sprintf("@post('/threads/%s/rename')", thread.ID),
				},
			}) {
				Save
			}
		</div>
	}
	@ui.Dialog(deleteThreadDialogID, nil) {
		<h2 class="text-ui-emphasis font-semibold">Delete this chat?</h2>
		<p class="mt-2 leading-6 text-muted">The chat and all its messages are deleted. This can't be undone.</p>
		<div class="mt-6 flex justify-end gap-2">
			@ui.Button(ui.ButtonProps{
				Variant: ui.Ghost,
				Attrs:   templ.Attributes{"commandfor": deleteThreadDialogID, "command": "close"},
			}) {
				Cancel
			}
			@ui.Button(ui.ButtonProps{
				Variant: ui.Danger,
				Attrs: templ.Attributes{
					"data-indicator:_delete_thread_pending": true,
					"data-attr:disabled":                    "$_delete_thread_pending",
					"data-on:click":                         fmt.Sprintf("@post('/threads/%s/delete')", thread.ID),
				},
			}) {
				Delete
			}
		</div>
	}
}

templ messageScrollRestore() {
	<script>
		{
			const el = document.querySelector('#messages')
			el.scrollTop = el.scrollHeight
		}
	</script>
}

templ MessageList(props MessageThreadProps) {
	<div
		id="messages"
		data-ref:_messages
		class="
			thread-mask min-h-0 flex-1 overflow-x-hidden overflow-y-auto overscroll-contain [overflow-anchor:auto]
			[scrollbar-color:var(--color-line-strong)_transparent] [scrollbar-gutter:stable] [scrollbar-width:thin]
		"
		data-on:scroll__debounce.10ms="
			const overflow = el.scrollHeight - el.clientHeight;
			const distanceFromBottom = overflow - el.scrollTop;
			$_showJumpToBottom = overflow > 200 && distanceFromBottom > 48;
		"
	>
		<div class="mx-auto w-full max-w-thread px-6 pb-6">
			for _, message := range props.Messages {
				@messageGroup(message)
			}
		</div>
	</div>
}

templ messageGroup(group MessageGroup) {
	switch group := group.(type) {
		case UserMessageProps:
			@userMessage(group)
		case AssistantMessagePartsProps:
			@assistantMessage(group)
	}
}

templ userMessage(props UserMessageProps) {
	<div id={ "msg-" + props.ID } class="user-message mt-10 flex scroll-mt-6 flex-col items-end">
		<div
			class="
				w-fit max-w-bubble min-w-0 rounded-dock border border-line bg-surface-raised px-3.5
				py-2 text-body break-words text-ink
				[&_.markdown-content_p]:m-0 [&_.markdown-content_p+p]:mt-2
			"
		>
			@markdownContent(props.MdContent)
		</div>
		<div class="mt-1.5 flex items-center gap-1.5 text-label text-muted [&_svg]:size-3.25">
			@ui.ClockIcon()
			<local-time datetime={ props.CreatedAt.UTC().Format(time.RFC3339) }>{ clockTime(ctx, props.CreatedAt) }</local-time>
		</div>
	</div>
}

templ assistantMessage(props AssistantMessagePartsProps) {
	<div
		id={ "msg-" + props.ID }
		class={ "flex flex-col", templ.KV("min-h-[calc(100dvh-(--spacing(52)))]", props.LargeHeight) }
	>
		if props.Working || len(props.Work) > 0 {
			<details
				id={ workID(props) }
				class="work mt-4.5"
				data-preserve-attr="open"
			>
				<summary
					class="
						flex w-full cursor-pointer list-none items-center gap-1.5 border-b border-line pb-2.5 text-ui
						font-medium tracking-tight text-ink-secondary select-none transition-colors hover:text-ink
					"
				>
					if props.Working {
						<span class="shimmer">
							Working for <elapsed-time since={ unixMilli(props.StartedAt) }>{ elapsedLabel(props.StartedAt, time.Now()) }</elapsed-time>
						</span>
					} else {
						<span>{ fmt.Sprintf("Worked for %ds", props.WorkSeconds) }</span>
					}
					<span class="chev text-muted transition-transform duration-200 [&_svg]:size-3.5">
						@ui.ChevronRightIcon()
					</span>
				</summary>
				<div class="flex flex-col gap-2.5 pt-3.5">
					for _, part := range props.Work {
						@workPart(part)
					}
					if props.Working {
						@workStatus(props.Status)
					}
				</div>
			</details>
		}
		if props.AnswerHTML != "" {
			<div
				class={
					"answer mt-5.5 text-body text-ink-body",
					templ.KV("is-streaming", props.Streaming),
				}
			>
				@markdownContent(props.AnswerHTML)
			</div>
			if len(props.Sources) > 0 {
				<div class="mt-7 border-b border-line pb-2.5 text-ui font-medium tracking-tight text-ink-secondary">
					Sources
				</div>
				<ol class="mt-3.5 flex flex-col gap-2.5">
					for _, source := range props.Sources {
						<li>
							<a
								href={ templ.SafeURL(source.URL) }
								target="_blank"
								rel="noopener noreferrer"
								class="group flex min-w-0 items-center gap-2.5 text-ui whitespace-nowrap no-underline"
							>
								@citeNumber(source.Number)
								<span class="min-w-0 truncate text-ink-body group-hover:text-ink">{ source.Title }</span>
								<span class="flex-none text-muted">{ source.Domain }</span>
							</a>
						</li>
					}
				</ol>
			}
		}
	</div>
}

templ citeNumber(n int) {
	<span
		class="
			grid h-4 min-w-4 flex-none place-items-center rounded px-1 bg-accent-soft text-meta font-medium
			text-accent tabular-nums
		"
	>{ strconv.Itoa(n) }</span>
}

templ markdownContent(html string) {
	<div class="markdown-content">
		@templ.Raw(html)
	</div>
}

const workRowClass = `
	flex min-h-5.5 min-w-0 items-center gap-1.5 text-ui whitespace-nowrap text-ink-secondary
	[&>svg]:mr-1 [&>svg]:text-muted
`

templ workPart(part AssistantPart) {
	switch part := part.(type) {
		case AssistantTextPartProps:
			<div
				id={ "part-" + part.ID }
				class="text-ui leading-6 text-ink-secondary [&_.markdown-content_p]:m-0"
			>
				@markdownContent(part.MdContent)
			</div>
		case ReasoningPartProps:
			<details id={ "part-" + part.ID } class="thought" data-preserve-attr="open">
				<summary
					class="
						flex w-fit cursor-pointer list-none items-center gap-1.5 text-ui text-ink-secondary
						select-none transition-colors hover:text-ink [&>svg]:text-muted
					"
				>
					@ui.SparkIcon()
					{ fmt.Sprintf("Thought for %ds", part.Seconds) }
					<span class="chev text-muted transition-transform duration-200 [&_svg]:size-3">
						@ui.ChevronRightIcon()
					</span>
				</summary>
				<div
					class="
						mt-1.5 mb-1 ml-1.75 border-l border-line pl-4.75 text-ui leading-relaxed text-ink-secondary
						[&_.markdown-content_p]:mb-2
					"
				>
					@markdownContent(part.MdContent)
				</div>
			</details>
		case ToolCallPartProps:
			{{ verb, target := toolCallDone(part.Name, part.Args) }}
			<div id={ "part-" + part.ID } class={ workRowClass }>
				if part.Name == "web_fetch" {
					@ui.GlobeIcon()
				} else {
					@ui.SearchSmallIcon()
				}
				<b class="font-medium text-ink-body">{ verb }</b>
				<span class="min-w-0 truncate">{ target }</span>
			</div>
		case SourceReadPartProps:
			<a
				id={ "part-" + part.ID }
				href={ templ.SafeURL(part.URL) }
				target="_blank"
				rel="noopener noreferrer"
				class={ workRowClass, "no-underline hover:text-ink" }
			>
				@ui.GlobeIcon()
				<b class="font-medium text-ink-body">Read</b>
				<span class="min-w-0 truncate">{ part.Title }</span>
				<span class="flex-none text-muted">{ part.Domain }</span>
			</a>
	}
}

templ workStatus(status Status) {
	<div class="relative h-6 overflow-hidden" role="status">
		<div
			id={ "status-" + status.Key }
			class="flex h-6 min-w-0 animate-status-in items-center gap-1.5 text-ui whitespace-nowrap [&>svg]:mr-1 [&>svg]:text-muted"
		>
			switch status.Icon {
				case StatusThinking:
					@ui.SparkIcon()
				case StatusSearching:
					@ui.SearchSmallIcon()
				case StatusReading:
					@ui.GlobeIcon()
				case StatusNoIcon:
			}
			<span class="shimmer flex-none font-medium">{ status.Verb }</span>
			if status.Target != "" {
				<span class="min-w-0 truncate text-ink-secondary">{ status.Target }</span>
			}
			if status.Words != "" {
				<span class="min-w-0 flex-1 overflow-hidden text-left text-muted" dir="rtl"><bdi>{ status.Words }</bdi></span>
			}
		</div>
	</div>
}

templ chatInput(threadID string, isStreaming bool) {
	<div
		class="
			bg-dock flex items-end gap-2 rounded-dock border border-line py-2 pr-2 pl-1 shadow-dock
			transition-colors aria-busy:border-accent-line
		"
		if threadID != "" {
			data-signals:thread-id={ fmt.Sprintf("'%s'", threadID) }
		}
		data-signals:_is-streaming={ strconv.FormatBool(isStreaming) }
		data-signals:message="''"
		data-computed:_can-submit="$message.trim() !== '' && !$_isStreaming"
		data-attr:aria-busy="$_sendingMessage && 'true'"
	>
		<textarea
			class="
				field-sizing-content block max-h-45 min-h-8 flex-1 resize-none border-0 bg-transparent px-3
				py-1.5 text-body leading-5 text-ink outline-none placeholder:text-muted
				[scrollbar-color:var(--color-line-strong)_transparent] [scrollbar-width:thin]
			"
			rows="1"
			autofocus
			name="message"
			placeholder="Ask anything"
			aria-label="Ask anything"
			data-indicator:_sending-message
			data-bind:message
			data-on:keydown="
				if (evt.key !== 'Enter' || evt.shiftKey) return;
				evt.preventDefault();
				if (!$_canSubmit) return;
				@post('/chat/send');
			"
		></textarea>
		<button
			type="button"
			aria-label="Send message"
			class="
				grid size-8 flex-none cursor-pointer place-items-center rounded-full bg-ink text-canvas
				transition-colors disabled:cursor-default disabled:bg-surface-strong disabled:text-muted
			"
			style={ hiddenStyle(isStreaming) }
			disabled
			data-show="!$_isStreaming"
			data-attr:disabled="!$_canSubmit"
			data-on:click="@post('/chat/send')"
		>
			@ui.ArrowUpSmallIcon()
		</button>
		<button
			type="button"
			aria-label="Stop response"
			class="grid size-8 flex-none cursor-pointer place-items-center rounded-full bg-ink text-canvas [&_svg]:size-3"
			style={ hiddenStyle(!isStreaming) }
			data-show="$_isStreaming"
			data-on:click="@post('/chat/stop')"
		>
			@ui.StopSmallIcon()
		</button>
	</div>
}

func hiddenStyle(hidden bool) string {
	if hidden {
		return "display: none"
	}
	return ""
}
