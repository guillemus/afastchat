{{ extends "layouts/main.tmpl" }}

{{ block body() }}
    <div
        class="app"
        data-signals:message="''"
        data-signals:threadId="''"
        data-signals:loading="false"
    >
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <div class="sidebar-header-left">
                    <button class="sidebar-toggle">&#9776;</button>
                    <span class="logo">T3.chat</span>
                </div>
            </div>

            <button class="new-chat-btn">New Chat</button>

            <div class="search-box">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <circle cx="11" cy="11" r="8" />
                    <path d="m21 21-4.3-4.3" />
                </svg>
                <input type="text" placeholder="Search your threads..." />
            </div>

            <div class="thread-list">
                <div class="thread-item">EU Achievements Link Request</div>
                <div class="thread-item">Postgres as a Key-Value Store...</div>
                <div class="thread-item">School Shootings US Nov 2024</div>
                <div class="thread-item">User feedback is compiler err...</div>
                <div class="thread-item">Jeffrey Epstein Summary</div>
                <div class="thread-item">Body Rows for Back Workout</div>
                <div class="thread-item">Weed THC Levels Then and N...</div>
                <div class="thread-item">Data Intensive Apps - Old Fas...</div>
                <div class="thread-item">OCaml Unit Type Usage</div>
                <div class="thread-item">Man posing at night with mate...</div>
                <div class="thread-item">Improvised Hotel Workplace ...</div>
                <div class="thread-item">VSCode Snippets Auto-trigger</div>
                <div class="thread-item">VSCode LSP Definition Popup...</div>
                <div class="thread-item">Testing Effect retry schedule ...</div>
                <div class="thread-item">API Client Cookie Storage in ...</div>
                <div class="thread-item">JavaScript code with ongoing ...</div>
                <div class="thread-item">YouTube Effects Talk Recomm...</div>
                <div class="thread-item">No Equipment Whole Body Ex...</div>
                <div class="thread-item">Ghostty Docs Search</div>
                <div class="thread-item">John Blow's on Linkin...</div>
            </div>

            <div class="sidebar-footer">
                <div class="avatar">G</div>
            </div>
        </aside>

        <!-- Main -->
        <main class="main">
            <div class="main-header">
                <button>&#128339;</button>
                <button>&#9881;</button>
            </div>

            <div id="messages" class="main-body">
                <div id="scroll-anchor" class="scroll-anchor"></div>
            </div>

            <div class="chat-input-area">
                <div class="chat-input-box">
                    <textarea
                        rows="1"
                        autofocus
                        placeholder="Type your message here..."
                        data-bind:message
                        data-attr:disabled="$loading"
                        data-on:keydown="if(event.key === 'Enter' && !event.shiftKey && !$loading) { event.preventDefault(); @post('/chat/send') }"
                    ></textarea>
                </div>
            </div>
        </main>
    </div>
{{ end }}
