{{ import "icons.tmpl" }}

{{ block sidebar(threads, activeThreadId) }}
    <aside class="sidebar">
        <div class="sidebar-header">
            <span class="logo">datastar<span class="logo-accent">.chat</span></span>
        </div>

        <a href="/" class="new-chat-btn">
            {{ yield iconPlus() }}
            New Chat
        </a>

        <div class="search-box">
            {{ yield iconSearch() }}
            <input
                type="text"
                placeholder="Search threads…"
                data-bind:threadSearch
                data-on:input__debounce.150ms="@get('/threads/search')"
            />
        </div>

        <div class="thread-list">
            <div id="thread-section-recent" class="thread-section-label">Recent</div>
            <div id="thread-items">
                {{ range _, t := threads }}
                    {{ yield threadItem(thread=t, activeThreadId=activeThreadId) }}
                {{ end }}
            </div>
        </div>

        <div class="sidebar-footer">
            <div class="avatar">G</div>
            <span class="sidebar-footer-name">Guillem</span>
        </div>
    </aside>
{{ end }}

{{ block threadItem(thread, activeThreadId) }}
    <a
        id="thread-{{ thread.ID }}"
        href="/threads/{{ thread.ID }}"
        class="thread-item {{ if thread.ID == activeThreadId }}active{{ end }}"
    >
        <span class="thread-item-text">{{ thread.Title }}</span>
        <button
            class="archive-btn"
            data-on:click="event.preventDefault(); event.stopPropagation(); @post('/threads/{{ thread.ID }}/archive')"
        >
            {{ yield iconArchive() }}
        </button>
    </a>
{{ end }}

{{ block chatInput() }}
    <div class="chat-input-area">
        <div class="chat-input-box">
            <textarea
                rows="1"
                autofocus
                placeholder="Type your message here..."
                data-bind:message
                data-attr:disabled="$loading"
                data-on:keydown="
                            if (event.key !== 'Enter') return;
                            if (event.shiftKey) return;
                            if ($loading) return;
                            event.preventDefault();
                            @post('/chat/send');
                            $message = '';
                        "
            ></textarea>
        </div>
    </div>
{{ end }}
