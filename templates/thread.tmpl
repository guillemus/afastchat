{{ extends "layouts/main.tmpl" }}
{{ import "icons.tmpl" }}
{{ import "components.tmpl" }}

{{ block body() }}
    <div
        class="app"
        data-signals:message="''"
        data-signals:threadId="'{{ .Thread.ID }}'"
        data-signals:threadSearch="''"
        data-signals:loading="{{ .Streaming }}"
        data-init__delay.25ms="@get('/threads/{{ .Thread.ID }}/stream')"
    >
        {{ yield sidebar(threads=.Threads, activeThreadId=.Thread.ID) }}


        <!-- Main -->
        <main class="main">
            <div id="messages" class="main-body">
                {{ range _, m := .Messages }}
                    {{ if m.Role == "user" }}
                        {{ if m.Content }}
                            <div id="msg-{{ m.ID }}" class="message user-message">
                                {{ m.Content }}
                            </div>
                        {{ end }}
                    {{ else if m.Role == "assistant" }}
                        <div id="msg-{{ m.ID }}" class="message assistant-message">
                            {{ if m.Content }}{{ m.Content | raw }}{{ end }}
                        </div>
                    {{ end }}
                {{ end }}
                <div id="scroll-anchor" class="scroll-anchor"></div>
            </div>

            {{ yield chatInput() }}
        </main>
    </div>
{{ end }}
