{{ extends "layouts/main.tmpl" }}
{{ import "icons.tmpl" }}
{{ import "components.tmpl" }}

{{ block body() }}
    {{ yield appShellOpen(.Thread.ID) }}

        {{ yield sidebar(.Threads, .Thread.ID) }}

        <!-- Main -->
        <main class="main">
            <div id="messages" class="main-body">
                {{ range _, m := .Messages }}
                    {{ if m.Content }}
                        {{ if m.Role == "user" }}
                            <div id="msg-{{ m.ID }}" class="message user-message">
                                {{ m.Content }}
                            </div>
                        {{ else if m.Role == "assistant" }}
                            <div id="msg-{{ m.ID }}" class="message assistant-message"></div>
                            <div id="msg-{{ m.ID }}-raw" hidden>{{ m.Content }}</div>
                        {{ end }}
                    {{ end }}
                {{ end }}
                <div id="scroll-anchor" class="scroll-anchor"></div>
            </div>

            {{ yield chatInput() }}
        </main>
    </div>
    <script>
        datastarChat.initMarkdown('#messages', '.assistant-message', '-raw')
    </script>
{{ end }}
